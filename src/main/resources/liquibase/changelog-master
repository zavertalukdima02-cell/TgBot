databaseChangeLog:
  - changeSet:
      id: create_notification_task_table
      comment: Создаем таблицу notification_task для хранения запланированных уведомлений
      changes:
        - createTable:
            tableName: notification_task
            columns:
              - column:
                  name: id
                  type: BIGINT
                  autoIncrement: true
                  constraints:
                    primaryKey: true
              - column:
                  name: chat_id
                  type: BIGINT
              - column:
                  name: message_text
                  type: TEXT
              - column:
                  name: scheduled_time
                  type: DATETIME
